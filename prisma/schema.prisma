// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Work {
  id          Int      @id @default(autoincrement())
  title       String
  category    String
  year        Int
  instruments String

  duration    String?     // e.g., "5:30", "12 minutes"
  information String?     // General information about the piece
  programNotes String?    // Program notes text
  imageFileName String?   // For uploaded images
  
  // Store multiple video URLs as JSON array
  videoUrls   Json?       // Array of video URL strings: ["url1", "url2", "url3", ...]
  
  soundcloudUrl String?   // SoundCloud embed URL
  slug        String?     @unique // URL-friendly version of title

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("works")
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String

  @@map("users")
}

model About {
  id       Int    @id @default(autoincrement())
  text     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("about")
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  date        DateTime
  location    String
  venue       String?
  description String?
  eventType   String
  works       String?
  performers  String?
  website     String?
  posterUrl   String?  // Main poster image URL
  imageUrls   String[] // Additional images array
  pdfUrl      String?  // Program PDF URL
  isUpcoming  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("events")
}

model Writing {
  id          Int      @id @default(autoincrement())
  title       String
  author      String
  style       String?
  description String?  @db.Text
  pdfUrl      String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("writings")
}