// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Work {
  id          Int      @id @default(autoincrement())
  title       String
  category    String
  year        Int
  instruments String

  duration    String?     // e.g., "5:30", "12 minutes"
  information String?     // General information about the piece
  programNotes String?    // Program notes text
  imageFileName String?   // For uploaded images
  videoUrl    String?     // YouTube, Vimeo, etc.
  soundcloudUrl String?   // SoundCloud embed URL
  slug        String?     @unique // URL-friendly version of title

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("works")
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String

  @@map("users")
}

model About {
  id       Int    @id @default(autoincrement())
  text     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("about")
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  date        DateTime
  location    String   // or reference to Location model
  venue       String?  // specific venue name
  description String?
  eventType   String   // "concert", "premiere", "workshop", etc.
  works       String?  // works performed (could be JSON or comma-separated)
  performers  String?  // other performers/collaborators
  website     String?  // event website/link
  isUpcoming  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}